rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'adminbellaver@gmail.com';
    }

    function isValidProduct(product) {
      return product.keys().hasOnly([
          'nome',
          'categoria',
          'precoOriginal',
          'precoDesconto',
          'descricao',
          'imagens',
          'estoque',
          'tamanhos'
        ])
        && product.keys().hasAll([
          'nome',
          'categoria',
          'precoOriginal',
          'precoDesconto',
          'descricao',
          'estoque',
          'tamanhos'
        ])
        && product.nome is string
        && product.categoria in ['feminino', 'masculino', 'acessorios', 'calcados']
        && product.precoOriginal is string
        && product.precoDesconto is string
        && product.descricao is string
        && (!product.keys().hasAny(['imagens'])
          || (product.imagens is list && product.imagens.size() <= 3))
        && product.estoque is number
        && product.tamanhos is list;
    }

    match /produtos/{produtoId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidProduct(request.resource.data);
      allow delete: if isAdmin();
    }

    match /usuarios/{usuarioId} {
      allow read, write: if request.auth != null
        && request.auth.uid == usuarioId;

      match /favoritos/{produtoId} {
        allow read, delete: if request.auth != null
          && request.auth.uid == usuarioId;
        allow create: if request.auth != null
          && request.auth.uid == usuarioId
          && request.resource.data.keys().hasOnly(['produtoId', 'criadoEm'])
          && request.resource.data.keys().hasAll(['produtoId', 'criadoEm'])
          && request.resource.data.produtoId == produtoId;
        allow update: if false;
      }

      match /sacola/{itemId} {
        function ownsCartItem() {
          return request.auth != null
            && request.auth.uid == usuarioId
            && request.resource.data.keys().hasOnly([
              'produtoId',
              'nome',
              'preco',
              'precoAntigo',
              'imagem',
              'quantidadesPorTamanho',
              'estoque',
              'atualizadoEm'
            ])
            && request.resource.data.keys().hasAll([
              'produtoId',
              'nome',
              'preco',
              'precoAntigo',
              'imagem',
              'quantidadesPorTamanho',
              'estoque',
              'atualizadoEm'
            ])
            && request.resource.data.produtoId is string
            && exists(
              /databases/$(database)/documents/produtos/$(request.resource.data.produtoId)
            )
            && request.resource.data.nome is string
            && request.resource.data.preco is string
            && request.resource.data.precoAntigo is string
            && request.resource.data.imagem is string
            && request.resource.data.imagem.size() <= 160000
            && request.resource.data.quantidadesPorTamanho is map
            && request.resource.data.quantidadesPorTamanho.keys().size() > 0
            && request.resource.data.quantidadesPorTamanho.keys().size() <= 5
            && request.resource.data.estoque is number
            && request.resource.data.estoque
              <= get(
                /databases/$(database)/documents/produtos/$(request.resource.data.produtoId)
              ).data.estoque;
        }

        allow read, delete: if request.auth != null
          && request.auth.uid == usuarioId;
        allow create, update: if ownsCartItem();
      }
    }
  }
}
