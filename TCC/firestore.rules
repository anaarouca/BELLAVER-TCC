rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'adminbellaver@gmail.com';
    }

    function isValidProduct(product) {
      return product.keys().hasOnly([
          'nome',
          'categoria',
          'precoOriginal',
          'precoDesconto',
          'descricao',
          'imagens',
          'estoque',
          'tamanhos'
        ])
        && product.keys().hasAll([
          'nome',
          'categoria',
          'precoOriginal',
          'precoDesconto',
          'descricao',
          'estoque',
          'tamanhos'
        ])
        && product.nome is string
        && product.categoria in ['feminino', 'masculino', 'acessorios', 'calcados']
        && product.precoOriginal is string
        && product.precoDesconto is string
        && product.descricao is string
        && (!product.keys().hasAny(['imagens'])
          || (product.imagens is list && product.imagens.size() <= 3))
        && product.estoque is number
        && product.tamanhos is list;
    }

    match /produtos/{produtoId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidProduct(request.resource.data);
      allow delete: if isAdmin();
    }
  }
}
